# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# el ejemplo sí se versiona
!.env.example

# supabase cli
/supabase/.branches
/supabase/.temp
/supabase/.env

# binarios de skills de terceros: son por plataforma y pesan ~15 MB cada uno.
# Cada persona los baja con `npx impeccable install`.
**/skills/*/scripts/bin/

# playwright mcp: capturas, snapshots y logs de consola de cada sesión de revisión
/.playwright-mcp

# impeccable: los contratos de dirección (surfaces/) sí se versionan, porque
# son la estrategia que el equipo hereda. El resto es estado de sesión.
/.impeccable/questions
/.impeccable/hook.cache.json
/.impeccable/mocks
/.impeccable/review
/.impeccable/build

# Archivos de bloqueo que deja Word abierto.
~$*

# Directorio temporal de trabajo / pruebas
scratch/

