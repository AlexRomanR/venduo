# ============================================================================
# Venduo MVP - variables de entorno
# Copiá este archivo a .env.local y completá lo que uses.
# El proyecto arranca aunque esté todo vacío: funciona en modo demo.
# ============================================================================

# --- Supabase -------------------------------------------------------------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Salta RLS: nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inteligencia artificial ---------------------------------------------
# Proveedor: anthropic | openai-compatible | google | mock
# "mock" es el modo demo: no llama a ninguna API.
AI_PROVIDER=mock

# Modelo. Si lo dejás vacío, cada adaptador usa su valor por defecto:
#   anthropic          -> claude-opus-5
#   openai-compatible  -> gpt-4o-mini
#   google             -> gemini-2.0-flash
AI_MODEL=

# API key del proveedor elegido.
AI_API_KEY=

# Solo para openai-compatible: apuntá a Groq, OpenRouter, Ollama, vLLM, etc.
# Ej: https://api.groq.com/openai/v1  |  http://localhost:11434/v1
AI_BASE_URL=

# --- App ------------------------------------------------------------------
# URL pública del sitio. En Vercel se deduce sola; en local podés dejarla vacía.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# La app del emprendedor (repositorio venduo-app). Con esto, un enlace del
# panel abre la app en vez del navegador. Vacías, la web no confirma nada.
# Huellas SHA-256 de la firma en Android, separadas por coma (eas credentials).
APP_ANDROID_HUELLAS=
# En iPhone: el equipo de Apple, un punto y el paquete. Ej.: ABCDE12345.bo.venduo.app
APP_IOS_ID=
